{
  "name": "pi-verify",
  "version": "0.1.0",
  "description": "Composable evidence collection and verification reports for Pi workflows",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run build && npm test"
  },
  "bin": {
    "pi-verify": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "pi-package"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "dist/src",
    "README.md",
    "REQUIREMENTS.md"
  ],
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "shiki": "4.6.0",
    "typescript": "^5.9.3"
  }
}
